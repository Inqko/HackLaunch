# База данных: по умолчанию SQLite (ничего ставить не нужно).
# Для Postgres: postgresql+asyncpg://user:pass@localhost:5432/hacklaunch
DATABASE_URL=sqlite+aiosqlite:///./hacklaunch.db

JWT_SECRET=dev-secret-change-me-in-production-please
JWT_EXPIRE_MINUTES=10080

CORS_ORIGINS=["http://localhost:5173"]

# GitLab: без токена или с USE_MOCK_GITLAB=true работает MockGitLabClient
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=
GITLAB_NAMESPACE_ID=
USE_MOCK_GITLAB=true

# Синхронизация задач с issues GitLab.
# GITLAB_WEBHOOK_URL — публичный адрес бэкенда (в dev удобно ngrok/cloudflared).
# Пустые URL/секрет отключают автоматическую регистрацию вебхука и приём событий.
GITLAB_WEBHOOK_URL=
GITLAB_WEBHOOK_SECRET=
# Метка, по которой отличаем issues HackLaunch от остальных issues репозитория.
GITLAB_TASK_LABEL=hacklaunch

# ИИ: auto | deepseek | gemini. auto берет DeepSeek, если есть ключ, иначе Gemini.
# Без ключей ИИ работает в фоллбэк-режиме (шаблонные задачи + эвристический анализ)
AI_PROVIDER=auto

DEEPSEEK_API_KEY=
# Любой OpenAI-совместимый провайдер: официальный https://api.deepseek.com или, например, https://inference.dahl.global/v1
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Запасные модели (JSON-список) на случай перегрузки основной, например для dahl.global:
# ["MiniMaxAI/MiniMax-M2.7","zai-org/GLM-5.3-Flash"]
DEEPSEEK_FALLBACK_MODELS=[]
# true — отключить «размышления» (для vLLM-провайдеров вроде dahl.global; ответ в разы быстрее)
DEEPSEEK_DISABLE_THINKING=false

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Почта для кодов подтверждения смены/сброса пароля.
# Без SMTP_HOST код пишется в лог бэкенда.
# EMAIL_DEBUG=true возвращает код в ответе API — только для локальной разработки!
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@hacklaunch.local
SMTP_USE_TLS=true
EMAIL_DEBUG=true
PASSWORD_CODE_TTL_MINUTES=10

# Аватары пользователей
UPLOAD_DIR=uploads
AVATAR_MAX_MB=5

# ИИ-ревью: как часто проверять ветки задач на новые коммиты, сек (0 — выключить)
REVIEW_POLL_SECONDS=60
