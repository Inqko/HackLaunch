# База данных: по умолчанию SQLite (ничего ставить не нужно).
# Для Postgres: postgresql+asyncpg://user:pass@localhost:5432/hacklaunch
DATABASE_URL=sqlite+aiosqlite:///./hacklaunch.db

JWT_SECRET=dev-secret-change-me-in-production-please
JWT_EXPIRE_MINUTES=10080

CORS_ORIGINS=["http://localhost:5173"]

# GitLab: без токена или с USE_MOCK_GITLAB=true работает MockGitLabClient
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=
GITLAB_NAMESPACE_ID=
USE_MOCK_GITLAB=true

# Синхронизация задач с issues GitLab.
# GITLAB_WEBHOOK_URL — публичный адрес бэкенда (в dev удобно ngrok/cloudflared).
# Пустые URL/секрет отключают автоматическую регистрацию вебхука и приём событий.
GITLAB_WEBHOOK_URL=
GITLAB_WEBHOOK_SECRET=
# Метка, по которой отличаем issues HackLaunch от остальных issues репозитория.
GITLAB_TASK_LABEL=hacklaunch

# Gemini: без ключа ИИ работает в фоллбэк-режиме (шаблонные задачи + эвристический анализ)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
